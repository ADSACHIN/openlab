# Normalise line endings: LF in the repository, native on checkout
* text=auto eol=lf

# Source and config files are always text
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.mp3   binary
*.mp4   binary
*.webm  binary

# Lockfiles: treat as generated for diffs
package-lock.json -diff linguist-generated
pnpm-lock.yaml    -diff linguist-generated

# Language stats on GitHub
docs/** linguist-documentation
*.md    linguist-documentation
